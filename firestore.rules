rules_version = '2';

// CNNO security rules. Customers can never do admin actions (BR-06).
// The admin role is set by CNNO in the Firebase console (users/{uid}.role = "admin").
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // New profiles are always customers.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'customer';
      // Users may edit their own profile but never their role.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      // Customers create their own orders, always starting as Pending,
      // with one preferred date and one fulfilment method (BR-02).
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.fulfilment in ['pickup', 'delivery']
        && request.resource.data.preferredDate is timestamp
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && (request.resource.data.fulfilment == 'pickup'
            || request.resource.data.address.size() > 0);
      // Only the admin changes status (BR-01).
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Order number counter: may only go up by one.
    match /counters/orders {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.next == 1001;
      allow update: if signedIn() && request.resource.data.next == resource.data.next + 1;
    }

    // Written only by Cloud Functions (Admin SDK bypasses rules).
    match /mail/{id} {
      allow read, write: if false;
    }
  }
}
